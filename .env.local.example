# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Pooler connection (port 6543) — used by the app at runtime via Supabase JS
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# Direct connection (port 5432) — used only for migrations (drizzle-kit / CI)
DATABASE_URL_DIRECT=postgresql://postgres.[ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# ─── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Sentry ────────────────────────────────────────────────────────────────────
# Public DSN — safe to expose in the browser bundle
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXXXX

# Auth token for source-map uploads during CI builds (keep secret, never expose)
SENTRY_AUTH_TOKEN=sntrys_...

# Random secret for the /api/sentry-test?token= endpoint — generate with:
#   openssl rand -base64 32
SENTRY_TEST_TOKEN=your_random_secret_here
