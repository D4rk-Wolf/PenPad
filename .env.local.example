# ─── Database ──────────────────────────────────────────────────────────────────
# Cloud (Supabase): use the pooler URL (port 6543)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# Self-hosted (Docker): DATABASE_URL is set in docker-compose.yml — not needed here

# ─── Auth (better-auth) ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_random_secret_here
BETTER_AUTH_URL=http://localhost:3000

# ─── Supabase (cloud only — not required for self-hosted) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Sentry ────────────────────────────────────────────────────────────────────
# Public DSN — safe to expose in the browser bundle
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXXXX

# Auth token for source-map uploads during CI builds (keep secret, never expose)
SENTRY_AUTH_TOKEN=sntrys_...

# Random secret for the /api/sentry-test?token= endpoint — generate with:
#   openssl rand -base64 32
SENTRY_TEST_TOKEN=your_random_secret_here

# ─── PostHog (product analytics — optional; leave blank to disable) ─────────────
# Project token from PostHog → Project Settings. Inert until set.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── Keygen (licensing) ────────────────────────────────────────────────────────
# KEYGEN_ACCOUNT_ID validates self-hosted license keys. The API token + policy id
# let the cloud Stripe webhook PROVISION a Pro license on purchase. Provisioning is
# inert (no-op + log) until all three are set.
KEYGEN_ACCOUNT_ID=
KEYGEN_API_TOKEN=
KEYGEN_POLICY_ID=

# ─── License-delivery email (Resend) ───────────────────────────────────────────
# Emails the buyer their license key + Docker quickstart. Inert until RESEND_API_KEY set.
RESEND_API_KEY=
LICENSE_EMAIL_FROM=PenPad <noreply@penpad.co.uk>

# ─── Self-hosted only ──────────────────────────────────────────────────────────
# Set to your Keygen license key (leave blank on cloud deployment)
PENPAD_LICENSE_KEY=

# ─── AI-assisted finding drafting (Pro feature) ────────────────────────────────
# Inert until set. Cloud: PenPad's key on Vercel. Self-hosted: the customer's own key.
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-sonnet-4-6.
# Cheapest for cloud trials: claude-haiku-4-5. Highest quality: claude-opus-4-8.
ANTHROPIC_MODEL=
